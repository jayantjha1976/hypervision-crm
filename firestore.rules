rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in owner can read or change their own data. Everything else is closed.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email == 'hypervision22@gmail.com';
    }
  }
}
